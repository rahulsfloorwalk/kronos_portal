{
    "parser": "babel-eslint",
    "env": {
        "browser": true,
        "es6": true,
	"jest": true
    },
    "extends": [
	    "eslint:recommended",
	    "plugin:react/recommended"
    ],
    "parserOptions": {
        "ecmaFeatures": {
            "experimentalObjectRestSpread": true,
            "jsx": true
        },
        "sourceType": "module"
    },
    "plugins": [
	"babel",
        "react"
    ],
    "rules": {
        "indent": [
            "warn",
            "tab"
        ],
        "linebreak-style": [
            "error",
            "unix"
        ],
        "quotes": [
            "warn",
            "double"
        ],
        "semi": [
            "error",
            "always"
        ],
        "no-extra-semi": 1,
	"react/jsx-uses-vars": 2,
	"babel/semi": 1
    }
}
