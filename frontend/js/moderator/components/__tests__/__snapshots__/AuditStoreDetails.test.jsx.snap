          </h4>
        </div>
        <div
          className="modal-body"
        >
          Please Enter reason for reverting the audit to auditor
          <textarea
            className="form-control"
            onBlur={[Function]}
            onChange={[Function]}
            rows="5"
            value=""
          />
          <span
            style={
              Object {
                "color": "red",
              }
            }
          />
        </div>
        <div
          className="modal-footer"
        >
          <button
            className="btn btn-primary"
            onClick={[Function]}
            type="button"
          >
            Submit
          </button>
          <button
            className="btn btn-default"
            onClick={[Function]}
            type="button"
          >
            Close
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
`;
