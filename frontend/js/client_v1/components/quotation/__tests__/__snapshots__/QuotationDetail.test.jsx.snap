exports[`<CustomizeQuotationAlert/> renders the customize quotation alert 1`] = `
<div
  className="modal"
  style={
    Object {
      "display": "block",
      "overflow": "scroll",
    }
  }
  tabIndex="-1"
>
  <div
    className="modal-backdrop fade in"
    style={
      Object {
        "height": "100%",
        "zIndex": "1060",
      }
    }
  />
  <div
    className="modal-dialog "
    style={
      Object {
        "zIndex": "1070",
      }
    }
  >
    <div
      className="modal-content"
    >
      <div
        className="modal-header"
      >
        <button
          className="close"
          type="button"
        >
          ×
        </button>
        <h4
          className="modal-title"
        >
          Customize Quotation alert
        </h4>
      </div>
      <div
        className="modal-body"
        style={
          Object {
            "maxHeight": "85vh",
            "overflowY": "scroll",
          }
        }
      >
        <div
          className="row"
        >
          <p
            className="text-center"
            style={
              Object {
                "fontSize": "15px",
              }
            }
          >
            Hello there! If you'd like for us to customize the audits for you, Please write to us and we will reach out to you in next 24 hours and help you customize this.
          </p>
          <br />
          <div
            className="text-center"
          >
            <button
              className="btn btn-primary"
            >
              Send Enquiry
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;

