### set log level to any one of: DEBUG, INFO, WARNING, ERROR, CRITICAL
### set to INFO preferably
log_level = "INFO"

### set this to the file where django logs are recorded
django_log_filename = "/home/foobar/kronos/logs/django.log"

### add log handlers, can contain 'logfile' which logs to above file or 'console' or both
### should use only 'logfile' in production and only 'console' in development
log_handlers = ['console', 'logfile']


